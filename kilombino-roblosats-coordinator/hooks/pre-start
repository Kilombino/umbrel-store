# rl15-3 to rl15-4 mounted these from the app's directory, where an update never put them, so
# docker made empty directories in their place: remove those.
for f in run.sh panel.py nginx.conf torrc strfry.conf federation_urls.txt; do
  [ -d "${APP_DATA_DIR}/${f}" ] && rmdir "${APP_DATA_DIR}/${f}" 2>/dev/null || true
done

# Roblosats coordinator: your settings. Edit, then restart the app (Umbrel → app → Restart).
# Never restart while an order is in progress (status 6 to 11 in the admin panel's Orders).

# Your coordinator's name, as robots and the federation see it.
COORDINATOR_ALIAS='My coordinator'
NODE_ALIAS='My coordinator'

# Trade fee (0.002 = 0.2 %) and the maker's share of it. Robots choose their bond (2 to 15 %, 3 by default).
FEE=0.002
MAKER_FEE_SPLIT=0.125

# Order sizes in sats: start small and raise them as your channels grow.
MIN_ORDER_SIZE=20000
MAX_ORDER_SIZE=1000000
MAX_PUBLIC_ORDERS=100

# On-chain payouts to buyers (needs on-chain funds in Lightning Fork) and their limits.
DISABLE_ONCHAIN=True
MIN_SWAP_AMOUNT=50000
MAX_SWAP_AMOUNT=1000000

# Donation to the Roblosats maintainer, as a share of your fees (0.1 = 10 %), by keysend.
DEVFUND=0.1

# A notice on your coordinator's page (none, info, warning, error, success).
NOTICE_SEVERITY='none'
NOTICE_MESSAGE=''

# Telegram alerts for you and your robots (create a bot with @BotFather).
TELEGRAM_TOKEN=''
TELEGRAM_BOT_NAME=''
TELEGRAM_COORDINATOR_CHAT_ID=''

ADMIN_TIME_ZONE=UTC

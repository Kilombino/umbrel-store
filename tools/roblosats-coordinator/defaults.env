# Roblosats coordinator: the app's recommended settings, the same as Kilobot (the first
# Roblosats coordinator) runs with. This file belongs to the app and is replaced on every
# update: change your settings on the app's page (Settings), which keeps only what you changed
# (panel/settings.local.env, read after this file).
# Never restart while an order is in progress (status 6 to 11 in the admin panel's Orders).

# Your coordinator's name, as robots and the federation see it.
COORDINATOR_ALIAS='My coordinator'
NODE_ALIAS='My coordinator'

# Trade fee (0.0019 = 0.19 %) and the maker's share of it (0.105 = 10.5 %; the taker pays the
# rest). Robots choose their bond (2 to 15 %, 3 by default).
FEE=0.0019
MAKER_FEE_SPLIT=0.105

# Order sizes in sats. The Roblosats apps start a new coordinator at 25M sats and raise that
# every two weeks; keep your largest order within what your channels can receive and send.
MIN_ORDER_SIZE=101000
MAX_ORDER_SIZE=100000000
MAX_PUBLIC_ORDERS=100

# On-chain payouts to buyers: a swap paid from Lightning Fork's on-chain wallet (offered only
# when that wallet has the funds), and their limits.
DISABLE_ONCHAIN=False
MIN_SWAP_AMOUNT=101000
MAX_SWAP_AMOUNT=6000000

# Donation to the Roblosats maintainer, as a share of your fees (0.1 = 10 %), by keysend.
DEVFUND=0.1

# A notice on your coordinator's page (none, info, warning, error, success).
NOTICE_SEVERITY='none'
NOTICE_MESSAGE=''

# Telegram alerts for you and your robots (create a bot with @BotFather).
TELEGRAM_TOKEN=''
TELEGRAM_BOT_NAME=''
TELEGRAM_COORDINATOR_CHAT_ID=''

ADMIN_TIME_ZONE=UTC
